          "traditional": "怎麼走",
          "pinyin": "zěnme zǒu",
          "gloss": "how to get there",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "請問銀行怎麼走？",
            "pinyin": "Qǐngwèn yínháng zěnme zǒu?",
            "gloss": "Excuse me, how do I get to the bank?"
          }
        },
        {
          "id": "v_zhizou",
          "traditional": "直走",
          "pinyin": "zhí zǒu",
          "gloss": "go straight",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "往前直走就到了。",
            "pinyin": "Wǎng qián zhí zǒu jiù dào le.",
            "gloss": "Go straight ahead and you're there."
          }
        },
        {
          "id": "v_zhuan",
          "traditional": "轉",
          "pinyin": "zhuǎn",
          "gloss": "to turn",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "在前面往右轉。",
            "pinyin": "Zài qiánmiàn wǎng yòu zhuǎn.",
            "gloss": "Turn right up ahead."
          }
        },
        {
          "id": "v_lukou",
          "traditional": "路口",
          "pinyin": "lùkǒu",
          "gloss": "intersection",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "在下一個路口左轉。",
            "pinyin": "Zài xià yí ge lùkǒu zuǒ zhuǎn.",
            "gloss": "Turn left at the next intersection."
          }
        },
        {
          "id": "v_fujin",
          "traditional": "附近",
          "pinyin": "fùjìn",
          "gloss": "nearby; vicinity",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "附近有便利商店嗎？",
            "pinyin": "Fùjìn yǒu biànlì shāngdiàn ma?",
            "gloss": "Is there a convenience store nearby?"
          }
        },
        {
          "id": "v_duimian",
          "traditional": "對面",
          "pinyin": "duìmiàn",
          "gloss": "across from; opposite",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "餐廳在銀行對面。",
            "pinyin": "Cāntīng zài yínháng duìmiàn.",
            "gloss": "The restaurant is across from the bank."
          }
        },
        {
          "id": "v_yinhang",
          "traditional": "銀行",
          "pinyin": "yínháng",
          "gloss": "bank",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "銀行在哪裡？",
            "pinyin": "Yínháng zài nǎlǐ?",
            "gloss": "Where is the bank?"
          }
        },
        {
          "id": "v_yuan",
          "traditional": "遠",
          "pinyin": "yuǎn",
          "gloss": "far",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "銀行遠不遠？",
            "pinyin": "Yínháng yuǎn bù yuǎn?",
            "gloss": "Is the bank far?"
          }
        }
      ],
      "grammar": [
        {
          "id": "g_wang_direction",
          "title": "往 — moving toward a direction",
          "pattern": "往 + Direction + Verb",
          "explanation": "往 (wǎng) marks the direction of movement and comes before the verb: 往前走 = walk forward, 往右轉 = turn right.",
          "examples": [
            {
              "hanzi": "往前直走。",
              "pinyin": "Wǎng qián zhí zǒu.",
              "gloss": "Go straight ahead."
            },
            {
              "hanzi": "在路口往左轉。",
              "pinyin": "Zài lùkǒu wǎng zuǒ zhuǎn.",
              "gloss": "Turn left at the intersection."
            },
            {
              "hanzi": "往右邊走就到了。",
              "pinyin": "Wǎng yòubiān zǒu jiù dào le.",
              "gloss": "Go to the right and you're there."
            }
          ],
          "hsk_level": 3
        }
      ],
      "dialogue": [
        {
          "speaker": "路人",
          "hanzi": "不好意思，請問銀行怎麼走？",
          "pinyin": "Bùhǎoyìsi, qǐngwèn yínháng zěnme zǒu?",
          "gloss": "Excuse me, how do I get to the bank?"
        },
        {
          "speaker": "我",
          "hanzi": "往前直走，在路口往右轉。",
          "pinyin": "Wǎng qián zhí zǒu, zài lùkǒu wǎng yòu zhuǎn.",
          "gloss": "Go straight, then turn right at the intersection."
        },
        {
          "speaker": "路人",
          "hanzi": "遠不遠？",
          "pinyin": "Yuǎn bù yuǎn?",
          "gloss": "Is it far?"
        },
        {
          "speaker": "我",
          "hanzi": "不遠，就在銀行對面。",
          "pinyin": "Bù yuǎn, jiù zài yínháng duìmiàn.",
          "gloss": "Not far, it's right across from the bank."
        }
      ],
