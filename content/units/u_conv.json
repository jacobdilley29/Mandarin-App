          "id": "v_shui",
          "traditional": "水",
          "pinyin": "shuǐ",
          "gloss": "water",
          "hsk_level": 1,
          "taiwan_note": null,
          "example": {
            "hanzi": "請給我一瓶水。",
            "pinyin": "Qǐng gěi wǒ yì píng shuǐ.",
            "gloss": "Please give me a bottle of water."
          }
        },
