          "traditional": "瓶",
          "pinyin": "píng",
          "gloss": "bottle (measure word)",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "我要兩瓶水。",
            "pinyin": "Wǒ yào liǎng píng shuǐ.",
            "gloss": "I want two bottles of water."
          }
        },
        {
          "id": "v_biandang",
          "traditional": "便當",
          "pinyin": "biàndāng",
          "gloss": "boxed meal; bento",
          "hsk_level": 2,
          "taiwan_note": "台灣用「便當」，不用「盒飯」。",
          "example": {
            "hanzi": "這個便當多少錢？",
            "pinyin": "Zhè ge biàndāng duōshǎo qián?",
            "gloss": "How much is this boxed meal?"
          }
        },
        {
          "id": "v_zhao",
          "traditional": "找",
          "pinyin": "zhǎo",
          "gloss": "to look for",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "我在找便當。",
            "pinyin": "Wǒ zài zhǎo biàndāng.",
            "gloss": "I'm looking for a boxed meal."
          }
        }
      ],
      "grammar": [
        {
          "id": "g_youmeiyou",
          "title": "有沒有 — asking if something exists",
          "pattern": "Subject + 有沒有 + Noun？",
          "explanation": "To ask whether something exists or is available, put 有沒有 (\"have-not-have\") before the noun. It's a quick yes/no question that doesn't need 嗎.",
          "examples": [
            {
              "hanzi": "你們有沒有便當？",
              "pinyin": "Nǐmen yǒu méiyǒu biàndāng?",
              "gloss": "Do you have boxed meals?"
            },
            {
              "hanzi": "這裡有沒有水？",
              "pinyin": "Zhèlǐ yǒu méiyǒu shuǐ?",
              "gloss": "Is there water here?"
            },
            {
              "hanzi": "他有沒有便當？",
              "pinyin": "Tā yǒu méiyǒu biàndāng?",
              "gloss": "Does he have a boxed meal?"
            }
          ],
          "hsk_level": 2,
          "taiwan_note": "台灣口語常用「有沒有 + 動詞」問過去的事：「你有沒有去？」「你有沒有吃？」大陸多說「你去了沒有？」「你吃過嗎？」。這個「有」的用法是台灣華語最明顯的特徵之一，受台語影響。"
        }
      ],
      "dialogue": [
        {
          "speaker": "客人",
          "hanzi": "不好意思，請問有沒有便當？",
          "pinyin": "Bùhǎoyìsi, qǐngwèn yǒu méiyǒu biàndāng?",
          "gloss": "Excuse me, do you have boxed meals?"
        },
        {
          "speaker": "店員",
          "hanzi": "有，便當在那邊。",
          "pinyin": "Yǒu, biàndāng zài nà biān.",
          "gloss": "Yes, the boxed meals are over there."
        },
        {
          "speaker": "客人",
          "hanzi": "我在找水。",
          "pinyin": "Wǒ zài zhǎo shuǐ.",
          "gloss": "I'm looking for water."
        },
        {
          "speaker": "店員",
          "hanzi": "水在那邊，這邊請。",
          "pinyin": "Shuǐ zài nà biān, zhè biān qǐng.",
          "gloss": "The water's over there, this way please."
        }
      ],
