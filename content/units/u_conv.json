          "traditional": "便利商店",
          "pinyin": "biànlì shāngdiàn",
          "gloss": "convenience store",
          "hsk_level": 3,
          "taiwan_note": "口語常說「小七」(7-Eleven) 或「超商」。",
          "example": {
            "hanzi": "那是便利商店。",
            "pinyin": "Nà shì biànlì shāngdiàn.",
            "gloss": "That's a convenience store."
          }
        },
        {
          "id": "v_dongxi",
          "traditional": "東西",
          "pinyin": "dōngxi",
          "gloss": "thing; stuff",
          "hsk_level": 1,
          "taiwan_note": null,
          "example": {
            "hanzi": "我想買一點東西。",
            "pinyin": "Wǒ xiǎng mǎi yìdiǎn dōngxi.",
            "gloss": "I want to buy a few things."
          }
        },
        {
          "id": "v_mai",
          "traditional": "買",
          "pinyin": "mǎi",
          "gloss": "to buy",
          "hsk_level": 1,
          "taiwan_note": null,
          "example": {
            "hanzi": "你要買什麼？",
            "pinyin": "Nǐ yào mǎi shénme?",
            "gloss": "What do you want to buy?"
          }
        },
