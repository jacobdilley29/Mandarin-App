        }
      ],
      "grammar": [
        {
          "id": "g_le_change",
          "title": "了 — a completed action",
          "pattern": "Subject + Verb + 了 + Object",
          "explanation": "了 after the verb marks that the action happened / is done: 買了 = bought. It's one of the most common uses of 了 in everyday Taiwan speech.",
          "examples": [
            {
              "hanzi": "我買了一個便當。",
              "pinyin": "Wǒ mǎi le yí ge biàndāng.",
              "gloss": "I bought a boxed meal."
            },
            {
              "hanzi": "他喝了一杯咖啡。",
              "pinyin": "Tā hē le yì bēi kāfēi.",
              "gloss": "He drank a coffee."
            },
            {
              "hanzi": "我買了一些東西。",
              "pinyin": "Wǒ mǎi le yìxiē dōngxi.",
              "gloss": "I bought a few things."
            }
          ],
          "hsk_level": 2,
          "taiwan_note": "台灣口語常用「有 + 動詞」表示做過了：「我有吃」「我有去」，大陸幾乎只說「我吃了」「我去了」。兩種在台灣都通，但「有」更口語。否定同樣用「沒有 + 動詞」。"
        }
      ],
