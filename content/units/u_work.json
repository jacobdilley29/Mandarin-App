          "taiwan_note": null,
          "example": {
            "hanzi": "他是我的同事。",
            "pinyin": "Tā shì wǒ de tóngshì.",
            "gloss": "He's my coworker."
          }
        },
        {
          "id": "v_laoban",
          "traditional": "老闆",
          "pinyin": "lǎobǎn",
          "gloss": "boss; shop owner",
          "hsk_level": 4,
          "taiwan_note": "也用來稱店家老闆。",
          "example": {
            "hanzi": "老闆對我們很好。",
            "pinyin": "Lǎobǎn duì wǒmen hěn hǎo.",
            "gloss": "The boss is good to us."
          }
        },
        {
          "id": "v_mang",
          "traditional": "忙",
          "pinyin": "máng",
          "gloss": "busy",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "我今天很忙。",
            "pinyin": "Wǒ jīntiān hěn máng.",
            "gloss": "I'm very busy today."
          }
        },
        {
          "id": "v_jiaban",
          "traditional": "加班",
          "pinyin": "jiābān",
          "gloss": "to work overtime",
          "hsk_level": 4,
          "taiwan_note": null,
          "example": {
            "hanzi": "今天要加班。",
            "pinyin": "Jīntiān yào jiābān.",
            "gloss": "I have to work overtime today."
          }
        }
      ],
      "grammar": [
        {
          "id": "g_yibian",
          "title": "一邊…一邊… — doing two things at once",
          "pattern": "一邊 + Verb1 + 一邊 + Verb2",
          "explanation": "一邊…一邊… links two actions happening at the same time: 一邊吃飯一邊開會 = have a meeting while eating.",
          "examples": [
            {
              "hanzi": "我一邊喝咖啡一邊工作。",
              "pinyin": "Wǒ yìbiān hē kāfēi yìbiān gōngzuò.",
              "gloss": "I work while drinking coffee."
            },
            {
              "hanzi": "他一邊上班一邊上學。",
              "pinyin": "Tā yìbiān shàngbān yìbiān shàngxué.",
              "gloss": "He works and studies at the same time."
            },
            {
              "hanzi": "別一邊開會一邊吃東西。",
              "pinyin": "Bié yìbiān kāihuì yìbiān chī dōngxi.",
              "gloss": "Don't eat during a meeting."
            }
          ],
          "hsk_level": 4
        }
      ],
