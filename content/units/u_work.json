      "vocab": [
        {
          "id": "v_shangban",
          "traditional": "上班",
          "pinyin": "shàngbān",
          "gloss": "to go to work",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "我早上九點上班。",
            "pinyin": "Wǒ zǎoshang jiǔ diǎn shàngbān.",
            "gloss": "I start work at nine in the morning."
          }
        },
        {
          "id": "v_xiaban",
          "traditional": "下班",
          "pinyin": "xiàbān",
          "gloss": "to get off work",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "我六點下班。",
            "pinyin": "Wǒ liù diǎn xiàbān.",
            "gloss": "I get off work at six."
          }
        },
        {
          "id": "v_kaihui",
          "traditional": "開會",
          "pinyin": "kāihuì",
          "gloss": "to have a meeting",
          "hsk_level": 4,
          "taiwan_note": null,
