            "hanzi": "下午我們要開會。",
            "pinyin": "Xiàwǔ wǒmen yào kāihuì.",
            "gloss": "We have a meeting this afternoon."
          }
        },
        {
          "id": "v_tongshi",
          "traditional": "同事",
          "pinyin": "tóngshì",
          "gloss": "coworker; colleague",
