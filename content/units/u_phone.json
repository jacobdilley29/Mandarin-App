          "example": {
            "hanzi": "我的手機沒電了。",
            "pinyin": "Wǒ de shǒujī méi diàn le.",
            "gloss": "My phone is out of battery."
          }
        },
        {
          "id": "v_wanglu",
          "traditional": "網路",
          "pinyin": "wǎnglù",
          "gloss": "internet; network",
          "hsk_level": 4,
          "taiwan_note": "台灣說「網路」，大陸說「網絡」。",
          "example": {
            "hanzi": "這裡有網路嗎？",
            "pinyin": "Zhèlǐ yǒu wǎnglù ma?",
            "gloss": "Is there internet here?"
          }
        },
