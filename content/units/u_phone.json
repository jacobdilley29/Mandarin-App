            "hanzi": "我用手機上網。",
            "pinyin": "Wǒ yòng shǒujī shàngwǎng.",
            "gloss": "I go online with my phone."
          }
        },
        {
          "id": "v_meidian",
          "traditional": "沒電",
          "pinyin": "méi diàn",
          "gloss": "out of power / battery",
