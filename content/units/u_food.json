      "grammar": [
        {
          "id": "g_de_complement",
          "title": "得 — saying how well an action goes",
          "pattern": "Verb + 得 + Adjective",
          "explanation": "得 links a verb to a comment on how it's done: 說得很好 = speaks (it) well. Note this 得 (de) is different from the completed-action 了.",
          "examples": [
            {
              "hanzi": "你說得很好。",
              "pinyin": "Nǐ shuō de hěn hǎo.",
              "gloss": "You speak very well."
            },
            {
              "hanzi": "他吃得很多。",
              "pinyin": "Tā chī de hěn duō.",
              "gloss": "He eats a lot."
            },
            {
              "hanzi": "我來得太早了。",
              "pinyin": "Wǒ lái de tài zǎo le.",
              "gloss": "I came too early."
            }
          ],
          "hsk_level": 3
        }
