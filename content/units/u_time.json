        {
          "id": "v_dianzhong",
          "traditional": "點鐘",
          "pinyin": "diǎnzhōng",
          "gloss": "o'clock",
          "hsk_level": 1,
          "taiwan_note": null,
          "example": {
            "hanzi": "現在三點鐘。",
            "pinyin": "Xiànzài sān diǎnzhōng.",
            "gloss": "It's three o'clock now."
          }
        },
        {
          "id": "v_zaoshang",
          "traditional": "早上",
          "pinyin": "zǎoshàng",
          "gloss": "morning",
