            "gloss": "I drink coffee in the morning."
          }
        },
        {
          "id": "v_xiawu",
          "traditional": "下午",
          "pinyin": "xiàwǔ",
          "gloss": "afternoon",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "下午我要工作。",
            "pinyin": "Xiàwǔ wǒ yào gōngzuò.",
