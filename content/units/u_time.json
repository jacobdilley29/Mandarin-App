          "traditional": "晚上",
          "pinyin": "wǎnshàng",
          "gloss": "evening; night",
          "hsk_level": 2,
          "taiwan_note": null,
          "example": {
            "hanzi": "晚上我在家。",
            "pinyin": "Wǎnshang wǒ zài jiā.",
            "gloss": "I'm home in the evening."
          }
        },
        {
          "id": "v_zhoumo",
          "traditional": "週末",
          "pinyin": "zhōumò",
          "gloss": "weekend",
          "hsk_level": 2,
          "taiwan_note": "台灣多用「週末」，也說「假日」。",
          "example": {
            "hanzi": "週末你想做什麼？",
            "pinyin": "Zhōumò nǐ xiǎng zuò shénme?",
            "gloss": "What do you want to do this weekend?"
          }
        },
        {
          "id": "v_yiqi",
          "traditional": "見面",
          "pinyin": "jiànmiàn",
          "gloss": "to meet up",
          "hsk_level": 3,
          "taiwan_note": null,
          "example": {
            "hanzi": "我們週末見面吧。",
            "pinyin": "Wǒmen zhōumò jiànmiàn ba.",
            "gloss": "Let's meet up this weekend."
          }
        }
      ],
      "grammar": [
        {
          "id": "g_time_before_verb",
          "title": "Time before the verb",
          "pattern": "Subject + Time + Verb …",
          "explanation": "In Chinese the time when something happens comes before the verb, not after: 我晚上回家 = I go home in the evening. Time can also lead the whole sentence.",
          "examples": [
            {
              "hanzi": "我早上喝咖啡。",
              "pinyin": "Wǒ zǎoshang hē kāfēi.",
              "gloss": "I drink coffee in the morning."
            },
            {
              "hanzi": "下午他要工作。",
              "pinyin": "Xiàwǔ tā yào gōngzuò.",
              "gloss": "He has to work in the afternoon."
            },
            {
              "hanzi": "週末我們一起吃飯。",
              "pinyin": "Zhōumò wǒmen yìqǐ chī fàn.",
              "gloss": "We eat together on the weekend."
            }
          ],
          "hsk_level": 2
        }
      ],
      "dialogue": [
        {
          "speaker": "朋友",
          "hanzi": "週末你有時間嗎？",
          "pinyin": "Zhōumò nǐ yǒu shíjiān ma?",
          "gloss": "Do you have time this weekend?"
        },
        {
          "speaker": "我",
          "hanzi": "有啊，你想做什麼？",
          "pinyin": "Yǒu a, nǐ xiǎng zuò shénme?",
          "gloss": "Yeah, what do you want to do?"
        },
        {
          "speaker": "朋友",
          "hanzi": "我們一起吃飯吧。",
          "pinyin": "Wǒmen yìqǐ chī fàn ba.",
          "gloss": "Let's have a meal together."
        },
        {
          "speaker": "我",
          "hanzi": "好，晚上六點見面。",
          "pinyin": "Hǎo, wǎnshang liù diǎn jiànmiàn.",
          "gloss": "OK, let's meet at six in the evening."
        }
      ],
