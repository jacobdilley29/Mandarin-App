      "grammar": [
        {
          "id": "g_haishi",
          "title": "還是 — \"or\" in questions",
          "pattern": "A 還是 B？",
          "explanation": "還是 offers a choice between two options in a question: A 還是 B = \"A or B?\". Don't use 或 (huò) here — 或 is for statements, 還是 is for questions.",
          "examples": [
            {
              "hanzi": "外帶還是內用？",
              "pinyin": "Wàidài háishì nèiyòng?",
              "gloss": "To go or dine in?"
            },
            {
              "hanzi": "你要紅茶還是奶茶？",
              "pinyin": "Nǐ yào hóngchá háishì nǎichá?",
