      "grammar": [
        {
          "id": "g_verb_dao",
          "title": "…到 — reaching a destination",
          "pattern": "Verb + 到 + Place",
          "explanation": "到 after a verb marks arrival at a place or point: 寄到台北 = mail (it) to Taipei, 走到路口 = walk to the intersection.",
          "examples": [
            {
              "hanzi": "這封信要寄到台北。",
              "pinyin": "Zhè fēng xìn yào jì dào Táiběi.",
              "gloss": "This letter goes to Taipei."
            },
            {
              "hanzi": "我們走到路口。",
              "pinyin": "Wǒmen zǒu dào lùkǒu.",
              "gloss": "We walk to the intersection."
