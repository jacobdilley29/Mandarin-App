          }
        }
      ],
      "grammar": [
        {
          "id": "g_yinggai",
          "title": "應該 — should",
          "pattern": "Subject + 應該 + Verb",
          "explanation": "應該 (yīnggāi) expresses what one should do: 你應該休息 = you should rest. It comes before the verb.",
          "examples": [
            {
              "hanzi": "你應該去看醫生。",
              "pinyin": "Nǐ yīnggāi qù kàn yīshēng.",
              "gloss": "You should go see a doctor."
            },
            {
              "hanzi": "感冒了應該多喝水。",
              "pinyin": "Gǎnmào le yīnggāi duō hē shuǐ.",
              "gloss": "When you have a cold you should drink lots of water."
            },
            {
              "hanzi": "你應該早點回家。",
              "pinyin": "Nǐ yīnggāi zǎo diǎn huí jiā.",
              "gloss": "You should go home earlier."
            }
          ],
          "hsk_level": 3
        }
      ],
