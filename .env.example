# Copy to .env and adjust. All values are optional — the app runs with defaults.

# Anthropic API key — OPTIONAL.
# When absent, the Talk (conversation) tab is disabled and everything else works.
ANTHROPIC_API_KEY=

# Whisper model for pronunciation scoring. tiny|base|small|medium.
WHISPER_MODEL=small

# Port the single FastAPI process listens on (serves API + built frontend).
# Under Docker this is the HOST-side port; the container always listens on 3002.
PORT=3002

# Host to bind. 0.0.0.0 so Tailscale Serve / your phone can reach it.
HOST=0.0.0.0

# --- Storage & backups (spec §7) -------------------------------------------
# Where the SQLite databases, audio cache and backups live.
# Leave unset for a native run (defaults to ./data). Docker Compose sets this
# to /data, the named volume, and ignores whatever is here.
#DATA_DIR=

# Rolling backup window. Backups older than this are pruned; the most recent
# one is always kept regardless of age.
BACKUP_RETENTION_DAYS=30

# When the backup container runs the nightly job (HH:MM, container local time).
BACKUP_TIME=03:30
